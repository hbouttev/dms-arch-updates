{
    "id": "cachyUpdates",
    "name": "CachyOS Updates",
    "description": "Repository, AUR, Flatpak and mise update status, with Cachy-Update and mise upgrades launched in your terminal",
    "version": "0.2.0",
    "author": "Hadrien Boutteville",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "dash-tab"],
    "icon": "system_update_alt",
    "components": {
        "daemon": "./UpdatesDaemon.qml",
        "widget": "./UpdatesWidget.qml",
        "dash": "./UpdatesTab.qml"
    },
    "dash": {
        "title": "Updates",
        "icon": "system_update_alt"
    },
    "settings": "./UpdatesSettings.qml",
    "requires_dms": ">=2.1.0",
    "dependencies": ["cachy-update", "pacman-contrib", "mise", "systemd"],
    "permissions": ["settings_read", "settings_write", "process", "network"]
}
