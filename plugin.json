{
    "id": "archUpdates",
    "name": "Arch Updates",
    "description": "Repository, AUR, Flatpak and mise update status for Arch Linux and Arch-based systems such as CachyOS. Updates run in your terminal with Arch-Update / Cachy-Update or directly with your AUR helper or pacman.",
    "version": "0.3.0",
    "author": "Hadrien Boutteville",
    "type": "composite",
    "capabilities": ["daemon", "dankbar-widget", "dash-tab"],
    "icon": "system_update_alt",
    "components": {
        "daemon": "./UpdatesDaemon.qml",
        "widget": "./UpdatesWidget.qml",
        "dash": "./UpdatesTab.qml"
    },
    "dash": {
        "title": "Updates",
        "icon": "system_update_alt"
    },
    "settings": "./UpdatesSettings.qml",
    "requires_dms": ">=2.1.0",
    "dependencies": ["pacman-contrib", "systemd"],
    "permissions": ["settings_read", "settings_write", "process", "network"]
}
